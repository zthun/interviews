{
  "name": "@zthun/interviews",
  "version": "0.0.1",
  "description": "A repository for demoing code for coding interviews.  Also has common problem solutions found on leet code.",
  "author": "Anthony Bonta",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/zthun/interviews"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "clean": "rimraf --glob 'dist' 'reports' '*.tgz' '*.log' 'packages/**/dist' 'packages/**/docs' 'packages/**/*.tgz' 'packages/**/*.log'",
    "check": "tsc --noEmit",
    "test": "vitest --run --coverage",
    "lint": "janitor-lint",
    "build": "lerna run build",
    "make": "npm run clean && npm run lint && npm run test && npm run build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.6.2",
    "@types/react": "^19.2.0",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "@zthun/janitor-build-config": "^19.3.4",
    "@zthun/janitor-lint": "^19.3.4",
    "@zthun/janitor-lint-config": "^19.3.4",
    "@zthun/janitor-options": "^19.3.4",
    "happy-dom": "^19.0.2",
    "husky": "^9.1.7",
    "lerna": "^9.0.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  },
  "packageManager": "yarn@4.10.3"
}
