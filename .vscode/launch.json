{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "attach",
      "name": "Attach to Interview Nest",
      "port": 9229,
      "address": "0.0.0.0",
      "remoteRoot": "/usr/dev",
      "localRoot": "${workspaceFolder}",
      "sourceMapPathOverrides": {
        "/usr/dev/*": "${workspaceRoot}/*"
      }
    },
    {
      "name": "Run Interview Leet Code",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/packages/interview-leet-code/src/cli.mts",
      "runtimeExecutable": "tsx",
      "console": "integratedTerminal"
    }
  ]
}
